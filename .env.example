# 本地模型路径。必须是已手动准备的 PP-OCRv5 mobile 推理模型目录。
# Windows 路径使用正斜杠。应用不会自动下载。
OCR_DET_DIR=
OCR_REC_DIR=
# 可选：ollama 或 deepseek。DeepSeek密钥只保存在本机.env中，禁止写入前端。
LLM_PROVIDER=ollama
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-flash
DEEPSEEK_API_KEY=
# 本机 Ollama 中已安装的模型名称；仅LLM_PROVIDER=ollama时使用。
OLLAMA_MODEL=
LLM_TIMEOUT=45
# 1 开启可选字符 TF-IDF + 朴素贝叶斯分类增强。
ENABLE_RISK_CLASSIFIER=0

# 可选自定义模型网关主机，逗号分隔；仅HTTPS443公网地址，不允许网页抓取/重定向。
MODEL_ALLOWED_HOSTS=

# 自定义SMTP服务器域名（逗号分隔），465 SSL/587 STARTTLS；保存配置不探测或发送邮件。
SMTP_ALLOWED_HOSTS=

# 部署相关（本机开发留空即可）
# 反向代理后允许的 Host 头，逗号分隔，如：career.example.com,10.0.0.5
EXTRA_ALLOWED_HOSTS=
# 允许跨域调用 API 的来源（精确匹配 scheme + host + port），逗号分隔
EXTRA_CORS_ORIGINS=
# 跨域携带会话 Cookie 时才需要同时改下面两项；CG_COOKIE_SECURE=1 要求站点走 HTTPS
CG_COOKIE_SAMESITE=strict
CG_COOKIE_SECURE=0
# SQLite 数据库路径，默认 <项目根>/.runtime/platform.sqlite3
CG_DB_PATH=
